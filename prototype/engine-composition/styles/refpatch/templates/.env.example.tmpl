{{- if .Is "database" "postgres" -}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
{{end -}}
{{- if .Is "database" "sqlite" -}}
DATABASE_URL=app.db
{{end -}}
{{- if .Is "sessions" "cookie" -}}
SESSION_KEY=replace-with-32-random-bytes
{{end -}}
{{- if .Is "cache" "redis" -}}
REDIS_URL=redis://localhost:6379/0
{{end -}}
